# Copy this file to .env and fill in YOUR SQL Server values.
# Do not commit .env. This is a service account for the API process only.
# Dashboard users login with Dashboard_Users + JWT, not with this SQL login.

DB_SERVER=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# Local SQL: ENCRYPT=false and TRUST_CERT=true
# Azure SQL: ENCRYPT=true and TRUST_CERT=false
DB_ENCRYPT=false
DB_TRUST_CERT=true

PORT=5000

# Required. Use a long random string. Do not reuse the SQL password.
JWT_SECRET=
# Leave empty so tokens do not expire. Set 1h or 7d only if you want expiry.
JWT_EXPIRES_IN=
