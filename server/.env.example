# Database connection settings
DB_SERVER=your_server_address
DB_PORT=1433
DB_USER=your_username
DB_PASSWORD=your_password
DB_DATABASE=your_database
# For Azure, set DB_ENCRYPT=true and DB_TRUST_CERT=false
# For local development, you can set DB_TRUST_CERT=true if using a self-signed certificate
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Server port
PORT=5000

# Set to true to use mock data instead of connecting to database
USE_MOCK_DATA=true
